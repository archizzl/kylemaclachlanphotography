{
  "name": "blog-cdn",
  "private": true,
  "scripts": {
    "dev": "wrangler d1 migrations apply blog-cdn --local && wrangler dev --port 8127",
    "test": "node --test test/*.test.js",
    "check": "node --test test/*.test.js && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "wrangler d1 migrations apply blog-cdn --remote && wrangler deploy",
    "dev:sites": "cd sites && wrangler dev --env local --port 8129",
    "deploy:sites": "cd sites && wrangler deploy --env=''"
  },
  "dependencies": {
    "markdown-it": "15.0.3"
  },
  "devDependencies": {
    "wrangler": "4.148.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
