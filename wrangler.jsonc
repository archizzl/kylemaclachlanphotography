{
  // kylemaclachlanphotography.org: blog hosting for friends. See README.md.
  "name": "blog-cdn",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "account_id": "649c6a97581779191e3dc398a800044b",
  "routes": [
    { "pattern": "kylemaclachlanphotography.org", "custom_domain": true },
    { "pattern": "www.kylemaclachlanphotography.org", "custom_domain": true }
  ],
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // Paths that need a signed-in check go to the Worker first. Anything else that isn't a
    // static file (feeds, post JSON, /_cdn locally) falls through to the Worker anyway.
    "run_worker_first": ["/", "/login", "/logout", "/dashboard", "/admin", "/admin/*", "/api/*"]
  },
  "vars": {
    // This site's public address, used in embed codes and feeds.
    "SITE_ORIGIN": "https://kylemaclachlanphotography.org",
    // Where uploaded files are served from: the R2 bucket's custom domain.
    // Locally, .dev.vars points these at http://localhost:8127 and http://localhost:8127/_cdn instead.
    "CDN_BASE": "https://cdn.kylemaclachlanphotography.org",
    // For the cost page: R2's free 10 GB a month is shared by the whole Cloudflare account, so the
    // Worker needs to know roughly what the account's other buckets hold (GB). On 2026-11-22:
    // ear-site 84 MB + cabin-site-media 11 MB + label-payouts-receipts 3.5 MB. Check with
    // `npx wrangler r2 bucket info <bucket>` now and then.
    "OTHER_STORAGE_GB": "0.1",
    // Who domains are registered and paid for through, as friends see it.
    "HOST_NAME": "Reaction Future Institute"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog-cdn",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "blog-cdn-files" }]
  // Secret (not in this file): ADMIN_PASSWORD.
}
