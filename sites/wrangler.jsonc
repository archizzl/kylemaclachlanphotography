{
  // Test sites for friends at <name>.kylemaclachlanphotography.org, to try a site out before
  // buying its own domain. A separate Worker from the blog app (../wrangler.jsonc), so deploying
  // a test site never touches the blog. See "test sites" in ../README.md.
  "name": "kmp-test-sites",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "account_id": "649c6a97581779191e3dc398a800044b",
  // One line per site; its files are in public/<name>/. Deploying creates the DNS record and certificate.
  "routes": [
    { "pattern": "bruteforce.kylemaclachlanphotography.org", "custom_domain": true },
    { "pattern": "brbtime.kylemaclachlanphotography.org", "custom_domain": true }
  ],
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // Every request goes through worker.js, which picks the folder from the hostname.
    "run_worker_first": true
  },
  // `wrangler dev --env local` (the kmp-test-sites launch config): no routes, so the hostname
  // isn't rewritten and http://<name>.localhost:8129 shows that site.
  "env": { "local": { "routes": [] } }
}
